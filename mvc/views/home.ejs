<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Airbnb Clone</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f7f7f7; color: #222; }
    .container { max-width: 900px; margin: 40px auto; padding: 20px; }
    .card { background: white; padding: 20px; border-radius: 10px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    form { display: grid; gap: 10px; }
    input, textarea { padding: 10px; border: 1px solid #ccc; border-radius: 6px; }
    button { padding: 10px 14px; background: #ff5a5f; color: white; border: none; border-radius: 6px; cursor: pointer; }
    .home-list { display: grid; gap: 15px; }
    .home-item { border: 1px solid #eee; padding: 15px; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>Airbnb-style Home Listing</h1>
      <p>Add a new home and see it appear on the homepage.</p>
    </div>

    <div class="card">
      <h2>Add a Home</h2>
      <form action="/homes" method="POST">
        <input type="text" name="title" placeholder="Home title" required />
        <input type="text" name="location" placeholder="Location" required />
        <input type="number" name="price" placeholder="Price per night" required />
        <textarea name="description" rows="3" placeholder="Description" required></textarea>
        <button type="submit">Add Home</button>
      </form>
    </div>

    <div class="card">
      <h2>Available Homes</h2>
      <div class="home-list">
        <% homes.forEach(home => { %>
          <div class="home-item">
            <h3><%= home.title %></h3>
            <p><strong>Location:</strong> <%= home.location %></p>
            <p><strong>Price:</strong> $<%= home.price %> / night</p>
            <p><%= home.description %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
